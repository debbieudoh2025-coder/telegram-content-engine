    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet text = item.output ?? item.response_ai_agent ?? item.content?.parts?.[0]?.text ?? item.text ?? '';\ntext = text.replace(/```json|```/g, '').trim();\n\nconst start = text.indexOf('{');\nconst end = text.lastIndexOf('}');\nif (start === -1 || end === -1) {\n  throw new Error('No JSON found. Gemini replied: ' + text.slice(0, 300));\n}\nconst raw = text.slice(start, end + 1);\n\n// turn real line breaks inside quoted text into \\n so the JSON is valid\nlet fixed = '';\nlet inString = false;\nlet escaped = false;\nfor (const ch of raw) {\n  if (inString) {\n    if (escaped) { fixed += ch; escaped = false; continue; }\n    if (ch === '\\\\') { fixed += ch; escaped = true; continue; }\n    if (ch === '\"') { fixed += ch; inString = false; continue; }\n    if (ch === '\\n') { fixed += '\\\\n'; continue; }\n    if (ch === '\\r') { continue; }\n    if (ch === '\\t') { fixed += '\\\\t'; continue; }\n    fixed += ch;\n  } else {\n    if (ch === '\"') inString = true;\n    fixed += ch;\n  }\n}\n\ntry {\n  return [{ json: JSON.parse(fixed) }];\n} catch (e) {\n  throw new Error('JSON is broken: ' + e.message + ' | Text: ' + fixed.slice(0, 300));\n}"
      },
